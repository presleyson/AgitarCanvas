# Copie este arquivo para .env.local e preencha com os dados do projeto Supabase.
# Sem estas variáveis a aplicação funciona em modo local (dados apenas neste navegador).

# URL do projeto (Supabase > Project Settings > API > Project URL)
VITE_SUPABASE_URL=

# Chave pública "anon" (Supabase > Project Settings > API > Project API keys).
# É segura para o navegador: o acesso aos dados é controlado por Row Level Security.
# Nunca use aqui a chave "service_role".
VITE_SUPABASE_ANON_KEY=
